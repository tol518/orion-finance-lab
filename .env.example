FINANCE_HOST=127.0.0.1
FINANCE_PORT=4830
FINANCE_DATA_DIR=./data
FINANCE_SERVICE_TOKEN=
FINANCE_AGENT_SIGNING_KEY=
FINANCE_BROKER_MODE=local
FINANCE_IBKR_HOST=127.0.0.1
FINANCE_IBKR_PORT=4002
FINANCE_IBKR_CLIENT_ID=91
FINANCE_IBKR_ACCOUNT_ID=
FINANCE_IBKR_PYTHON=python3
FINANCE_IBKR_TIMEOUT_MS=15000
# off (default) blocks broker execution entirely. dry-run sends IBKR whatIf previews:
# the order is validated and margin-checked by IBKR but never placed. live transmits a real
# paper order and books IBKR's own fill; it also needs Read-Only API unchecked in IB Gateway.
FINANCE_IBKR_EXECUTION=off
FINANCE_RISK_POLICY_JSON=
FINANCE_TRADINGAGENTS_PYTHON=python3
FINANCE_TRADINGAGENTS_REPO=
FINANCE_TRADINGAGENTS_TIMEOUT_MS=300000
