{
  "name": "@orion-os/finance-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Provider-agnostic financial research, deterministic risk, paper trading, and evaluation for Orion OS agents.",
  "engines": {
    "node": ">=24"
  },
  "orion": {
    "plugin": "./src/plugin/index.js"
  },
  "scripts": {
    "dev": "node --watch src/standalone.js",
    "start": "node src/standalone.js",
    "build": "npm --prefix ui run build",
    "test": "node --test",
    "verify:public": "node scripts/verify-public-release.mjs",
    "check": "npm run verify:public && npm test && npm run build"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "yahoo-finance2": "^4.0.3"
  },
  "peerDependencies": {
    "@orion-os/plugin-sdk": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@orion-os/plugin-sdk": {
      "optional": true
    }
  }
}
